{
  "name": "game1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @game/web",
    "build": "npm run build -w @game/web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "sim": "tsx packages/sim-cli/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "tsx": "^4.21.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
